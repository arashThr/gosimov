# Caddy terminates TLS (certificates are issued automatically) and proxies
# to the app. The domain comes from the DOMAIN environment variable.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:8000
}

# Uncomment to redirect www to the apex domain (needs a DNS record for www).
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
