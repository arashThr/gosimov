package home

import (
	"github.com/arashthr/skeleton/internal/ui"
	"github.com/arashthr/skeleton/internal/user"
)

templ LandingPage() {
	@ui.Layout("") {
		<section class="hero">
			<h1>Start your Go app with <span class="gradient-text">Goostrap</span><br/></h1>
			<p class="lead">
				A lean Go starter with accounts, sessions, OAuth, billing and deployment already wired up.
				Focus on the part that makes your product unique.
			</p>
			<div class="row">
				<a href="/signup" class="btn btn-primary btn-lg">Create an account</a>
				<a href="/signin" class="btn btn-lg">Sign in</a>
			</div>
		</section>
		<section class="features">
			<div class="card feature">
				<h3>Accounts built in</h3>
				<p>Password, magic link, Google and GitHub sign in, with email verification and password reset.</p>
			</div>
			<div class="card feature">
				<h3>Server-rendered</h3>
				<p>Type-safe templ components, a sprinkle of htmx and plain CSS. No build pipeline for the frontend.</p>
			</div>
			<div class="card feature">
				<h3>Postgres or SQLite</h3>
				<p>Portable SQL and embedded migrations. Switch engines with a single environment variable.</p>
			</div>
			<div class="card feature">
				<h3>Ready to ship</h3>
				<p>Docker image, Compose stack and Caddy with automatic HTTPS. Push and deploy.</p>
			</div>
		</section>
	}
}

templ DashboardPage(u *user.User) {
	@ui.Layout("Dashboard") {
		<div class="page-header">
			<h1>Dashboard</h1>
			<p>Signed in as { u.Email }</p>
		</div>
		if !u.EmailVerified() {
			<div class="alert alert-info">
				<div class="row">
					<span>Please verify your email address. We sent you a link when you signed up.</span>
					<button
						class="btn"
						hx-post="/verify-email/resend"
						hx-target="this"
						hx-swap="outerHTML"
					>Resend email</button>
				</div>
			</div>
		}
		<div class="grid-2">
			<div class="card">
				<div class="card-header">
					<h2>Your account</h2>
					if u.EmailVerified() {
						<span class="badge badge-success">Verified</span>
					} else {
						<span class="badge">Unverified</span>
					}
				</div>
				<dl class="dl">
					<dt>Email</dt>
					<dd>{ u.Email }</dd>
					<dt>Member since</dt>
					<dd>{ u.CreatedAt.Format("January 2, 2006") }</dd>
				</dl>
				<hr/>
				<a href="/account" class="btn">Manage account</a>
			</div>
			<div class="card">
				<h2>Start building</h2>
				<p class="muted">
					This page lives in <code>internal/home</code>. Add a new feature package next to it,
					register its module in <code>internal/app/app.go</code>, and you are off.
				</p>
			</div>
		</div>
	}
}
