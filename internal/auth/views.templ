package auth

import (
	"strconv"

	"github.com/arashthr/skeleton/internal/platform/flash"
	"github.com/arashthr/skeleton/internal/ui"
)

// formData is shared by the auth pages.
type formData struct {
	Email     string
	Next      string
	Token     string
	Error     string
	Providers []Provider
	Captcha   string // Turnstile site key, empty when disabled
}

templ authPage(title, subtitle string, footer templ.Component) {
	@ui.Layout(title) {
		<div class="auth">
			<h1>{ title }</h1>
			if subtitle != "" {
				<p class="subtitle">{ subtitle }</p>
			}
			<div class="card">
				{ children... }
			</div>
			if footer != nil {
				<p class="below">
					@footer
				</p>
			}
		</div>
	}
}

templ footerLink(text, href, label string) {
	{ text } <a href={ templ.SafeURL(href) }>{ label }</a>
}

templ SignInPage(d formData) {
	@authPage("Welcome back", "Sign in to your account", footerLink("No account yet?", "/signup", "Create one")) {
		@formError(d.Error)
		@providerButtons(d.Providers, d.Next)
		<form method="post" action="/signin">
			<input type="hidden" name="next" value={ d.Next }/>
			<label class="field">
				<span>Email</span>
				<input type="email" name="email" value={ d.Email } autocomplete="email" required autofocus/>
			</label>
			<label class="field">
				<span>Password <a href="/forgot-password" tabindex="-1">Forgot?</a></span>
				<input type="password" name="password" autocomplete="current-password" required/>
			</label>
			@captcha(d.Captcha)
			<button type="submit" class="btn btn-primary btn-block">Sign in</button>
		</form>
		<div class="divider">or</div>
		<a href="/magic-link" class="btn btn-block">Email me a sign-in link</a>
	}
}

templ SignUpPage(d formData) {
	@authPage("Create your account", "Start in less than a minute", footerLink("Already have an account?", "/signin", "Sign in")) {
		@formError(d.Error)
		@providerButtons(d.Providers, d.Next)
		<form method="post" action="/signup">
			<label class="field">
				<span>Email</span>
				<input type="email" name="email" value={ d.Email } autocomplete="email" required autofocus/>
			</label>
			<label class="field">
				<span>Password</span>
				<input type="password" name="password" autocomplete="new-password" minlength={ strconv.Itoa(MinPasswordLength) } required/>
				<div class="hint">At least { strconv.Itoa(MinPasswordLength) } characters.</div>
			</label>
			@captcha(d.Captcha)
			<button type="submit" class="btn btn-primary btn-block">Create account</button>
		</form>
		<div class="divider">or</div>
		<a href="/magic-link" class="btn btn-block">Sign up without a password</a>
	}
}

templ MagicLinkPage(d formData) {
	@authPage("Passwordless sign in", "We'll email you a link that signs you in, no password needed.", footerLink("", "/signin", "Back to sign in")) {
		@formError(d.Error)
		<form method="post" action="/magic-link">
			<label class="field">
				<span>Email</span>
				<input type="email" name="email" value={ d.Email } autocomplete="email" required autofocus/>
			</label>
			@captcha(d.Captcha)
			<button type="submit" class="btn btn-primary btn-block">Send me a link</button>
		</form>
	}
}

// MagicLinkConfirmPage asks for a click before consuming the token, so email
// scanners that prefetch links cannot use it up.
templ MagicLinkConfirmPage(token string) {
	@authPage("Almost there", "Confirm to finish signing in", nil) {
		<form method="post" action="/magic-link/verify">
			<input type="hidden" name="token" value={ token }/>
			<button type="submit" class="btn btn-primary btn-block">Continue</button>
		</form>
	}
}

templ ForgotPasswordPage(d formData) {
	@authPage("Forgot your password?", "Enter your email and we'll send you a reset link.", footerLink("", "/signin", "Back to sign in")) {
		@formError(d.Error)
		<form method="post" action="/forgot-password">
			<label class="field">
				<span>Email</span>
				<input type="email" name="email" value={ d.Email } autocomplete="email" required autofocus/>
			</label>
			@captcha(d.Captcha)
			<button type="submit" class="btn btn-primary btn-block">Send reset link</button>
		</form>
	}
}

templ ResetPasswordPage(d formData) {
	@authPage("Choose a new password", "You will be signed in right after.", nil) {
		@formError(d.Error)
		<form method="post" action="/reset-password">
			<input type="hidden" name="token" value={ d.Token }/>
			<label class="field">
				<span>New password</span>
				<input type="password" name="password" autocomplete="new-password" minlength={ strconv.Itoa(MinPasswordLength) } required autofocus/>
				<div class="hint">At least { strconv.Itoa(MinPasswordLength) } characters.</div>
			</label>
			<button type="submit" class="btn btn-primary btn-block">Update password</button>
		</form>
	}
}

templ CheckEmailPage(emailAddr, message string) {
	@authPage("Check your inbox", "", footerLink("", "/signin", "Back to sign in")) {
		<div class="center">
			<p>{ message }</p>
			if emailAddr != "" {
				<p><strong>{ emailAddr }</strong></p>
			}
			<p class="muted small">Didn't get it? Check your spam folder or try again in a minute.</p>
		</div>
	}
}

templ formError(msg string) {
	if msg != "" {
		@ui.Alert(flash.Error, msg)
	}
}

templ captcha(siteKey string) {
	if siteKey != "" {
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
		<div class="turnstile cf-turnstile" data-sitekey={ siteKey }></div>
	}
}

templ providerButtons(providers []Provider, next string) {
	if len(providers) > 0 {
		<div class="stack">
			for _, p := range providers {
				<a class="btn btn-block" href={ templ.SafeURL(oauthStartURL(p.Name(), next)) }>
					@providerIcon(p.Name())
					Continue with { p.Label() }
				</a>
			}
		</div>
		<div class="divider">or</div>
	}
}

templ providerIcon(name string) {
	switch name {
		case "google":
			<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.57c2.08-1.92 3.27-4.74 3.27-8.09z"></path><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.76c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"></path><path fill="#FBBC05" d="M5.84 14.11a6.6 6.6 0 0 1 0-4.22V7.05H2.18a11 11 0 0 0 0 9.9l3.66-2.84z"></path><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.96 10.96 0 0 0 12 1 11 11 0 0 0 2.18 7.05l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"></path></svg>
		case "github":
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.9 18.3 5.2 18.3 5.2c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path></svg>
	}
}
